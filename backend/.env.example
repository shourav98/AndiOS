# ==============================================================================
# AndiOS Backend — Production Environment Configuration (.env)
# ==============================================================================

# ─── 1. Application & URLs ──────────────────────────────────────────────────
# In production, set APP_ENV=production
APP_ENV=production
# Generate a strong 32+ char random string for JWT / internal encryption
SECRET_KEY=generate-a-strong-random-secret-key-for-jwt

# Live URLs (Pre-configured for your production deployment)
FRONTEND_URL=https://andi-os.vercel.app
API_BASE_URL=https://andreearizan.softvencealpha.com


# ─── 2. Supabase (Database & Auth) ──────────────────────────────────────────
# From Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_STORAGE_BUCKET=contracts


# ─── 3. OpenAI (AI Lead Qualification & Assistant) ──────────────────────────
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o


# ─── 4. WhatsApp Automation (Meta Cloud API / Twilio) ───────────────────────
# Choose your provider: "meta" (recommended / currently tested) or "twilio"
WHATSAPP_PROVIDER=meta

# [Meta WhatsApp Cloud API Settings]
# Permanent System User Access Token from Meta Business Suite
WHATSAPP_API_KEY=EAA...
# Phone Number ID from WhatsApp -> API Setup in Meta Developer Dashboard
WHATSAPP_PHONE_NUMBER_ID=106...
# Any secret string you choose (Must match the verify token in Meta Webhook configuration)
WHATSAPP_VERIFY_TOKEN=andios_verify_token
# App Secret from Meta App -> Basic Settings (used to verify webhook X-Hub-Signature-256)
META_APP_SECRET=your_meta_app_secret_here

# [Twilio WhatsApp Settings - Optional fallback/alternative]
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Shared secret for INBOUND WhatsApp webhooks (if using 360dialog)
WHATSAPP_WEBHOOK_TOKEN=


# ─── 5. Multi-Tenant Default Agency Routing ────────────────────────────────
# Agency UUID in Supabase to route inbound webhook leads when no specific agent/agency is in query param
DEFAULT_AGENCY_ID=11111111-1111-1111-1111-111111111111


# ─── 6. Property Portals Webhooks (Property Finder, Bayut, Dubizzle) ────────
# Webhook Secret configured in Property Finder portal partner settings
PROPERTY_FINDER_WEBHOOK_SECRET=your_property_finder_secret_here

# Shared-secret tokens for Bayut / Dubizzle (?token=... or X-Webhook-Token header)
BAYUT_WEBHOOK_TOKEN=your_bayut_webhook_token_here
DUBIZZLE_WEBHOOK_TOKEN=your_dubizzle_webhook_token_here


# ─── 7. Google Calendar Integration ─────────────────────────────────────────
# From Google Cloud Console -> APIs & Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
# Production Redirect URI (Must be added to Authorized Redirect URIs in Google Cloud Console)
GOOGLE_REDIRECT_URI=https://andreearizan.softvencealpha.com/connectors/google-calendar/callback
GOOGLE_CALENDAR_MODE=shared
GOOGLE_SHARED_CALENDAR_ID=your-shared-calendar@group.calendar.google.com


# ─── 8. Voice AI Calling (Vapi & Twilio BYON) ───────────────────────────────
VAPI_API_KEY=your-vapi-api-key
VAPI_PHONE_NUMBER_ID=your-vapi-phone-number-id
VAPI_ASSISTANT_ID=your-vapi-assistant-id
VAPI_WEBHOOK_SECRET=your-vapi-server-secret
VAPI_SIP_CREDENTIAL_ID=
VAPI_SIP_DOMAIN=sip.vapi.ai

# Central Twilio DID for Call Forwarding
CENTRAL_INBOUND_DID=


# ─── 9. Stripe Billing & Subscriptions ──────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PORTAL_RETURN_URL=https://andi-os.vercel.app/owner-dashboard/plan-billing

# Stripe Price IDs (AED)
STRIPE_PRICE_BASIC=price_basic_1400aed
STRIPE_PRICE_GROW=price_grow_2800aed
STRIPE_PRICE_PRO=price_pro_5600aed

# Recurring Add-ons
STRIPE_PRICE_ADDON_P1000=price_addon_1000
STRIPE_PRICE_ADDON_P2000=price_addon_2000
STRIPE_PRICE_ADDON_P5000=price_addon_5000
STRIPE_PRICE_ADDON_P10000=price_addon_10000

# Metered Overage Price
STRIPE_PRICE_OVERAGE=price_overage_2aed


# ─── 10. Platform Settings ──────────────────────────────────────────────────
QUOTA_ENFORCEMENT_ENABLED=true
