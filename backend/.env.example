# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o

# ─── WhatsApp ─────────────────────────────────────────────────────
WHATSAPP_PROVIDER=twilio
# 360dialog (optional)
WHATSAPP_API_KEY=your_360dialog_key_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_id_here
# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=your_twilio_number_here
WHATSAPP_VERIFY_TOKEN=andios_verify_token

# ─── Google Calendar ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/connectors/google-calendar/callback
GOOGLE_CALENDAR_MODE=shared           # options: shared | per_agent
GOOGLE_SHARED_CALENDAR_ID=your-shared-calendar-id@group.calendar.google.com

# ─── Property Finder ─────────────────────────────────────────────────────────
PROPERTY_FINDER_WEBHOOK_SECRET=your-pf-secret

# ─── Multi-Tenant Routing ────────────────────────────────────────────────────
DEFAULT_AGENCY_ID=

# ─── Vapi AI Caller (Sami) ───────────────────────────────────────────────────
VAPI_API_KEY=your-vapi-api-key
VAPI_PHONE_NUMBER_ID=your-vapi-phone-number-id
VAPI_ASSISTANT_ID=your-vapi-assistant-id

# ─── Supabase Storage ────────────────────────────────────────────────────────
SUPABASE_STORAGE_BUCKET=contracts

# ─── Stripe Billing ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/owner-dashboard/plan-billing

# Stripe Recurring Plan Price IDs (AED)
STRIPE_PRICE_BASIC=price_basic_1400aed
STRIPE_PRICE_GROW=price_grow_2800aed
STRIPE_PRICE_PRO=price_pro_5600aed

# Stripe Recurring Add-on Price IDs (AED)
STRIPE_PRICE_ADDON_P1000=price_addon_1000calls_2000aed
STRIPE_PRICE_ADDON_P2000=price_addon_2000calls_4000aed
STRIPE_PRICE_ADDON_P5000=price_addon_5000calls_10000aed
STRIPE_PRICE_ADDON_P10000=price_addon_10000calls_20000aed

# Stripe Metered Overage Price ID (AED 2.00 / call)
STRIPE_PRICE_OVERAGE=price_overage_2aed_metered

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development                   # development | production
SECRET_KEY=your-jwt-secret-key-change-this
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

