# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o

# ─── WhatsApp ─────────────────────────────────────────────────────
WHATSAPP_PROVIDER=twilio
# 360dialog (optional)
WHATSAPP_API_KEY=your_360dialog_key_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_id_here
# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=your_twilio_number_here
WHATSAPP_VERIFY_TOKEN=andios_verify_token

# ─── Google Calendar ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/connectors/google-calendar/callback
GOOGLE_CALENDAR_MODE=shared           # options: shared | per_agent
GOOGLE_SHARED_CALENDAR_ID=your-shared-calendar-id@group.calendar.google.com

# ─── Property Finder ─────────────────────────────────────────────────────────
PROPERTY_FINDER_WEBHOOK_SECRET=your-pf-secret

# ─── Multi-Tenant Routing ────────────────────────────────────────────────────
DEFAULT_AGENCY_ID=

# ─── Vapi AI Caller (Sami) ───────────────────────────────────────────────────
VAPI_API_KEY=your-vapi-api-key
VAPI_PHONE_NUMBER_ID=your-vapi-phone-number-id
VAPI_ASSISTANT_ID=your-vapi-assistant-id

# ─── Supabase Storage ────────────────────────────────────────────────────────
SUPABASE_STORAGE_BUCKET=contracts

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development                   # development | production
SECRET_KEY=your-jwt-secret-key-change-this
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
